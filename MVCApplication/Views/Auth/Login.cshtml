@using MVCApplication.Dto
@model UserDTo

<form class="d-flex align-items-center justify-content-center" style="min-height: 100vh;" asp-action="LoginUser">
    
    <div class="card p-4 shadow" style="width:100%; max-width:400px">
        <h3 class="text-center mb-4">Login</h3>

        @if (ViewBag.SuccessMessage != null)
        {
            <div class="alert alert-success py-2 text-center" role="alert">
                @ViewBag.SuccessMessage
            </div>
        }
        @if (ViewBag.ErrorMessage != null)
        {
            <div class="alert alert-danger py-2 text-center" role="alert">
                @ViewBag.ErrorMessage
            </div>
        }
        <div class="mb-3">
            <label for="email" class="form-label">Email address</label>
            <input type="email" class="form-control" id="email" name="email" asp-for="Email" placeholder="name@example.com" required>
        </div>

        <div class="mb-3">
            <label for="password" class="form-label">Password</label>
            <input type="password" class="form-control" id="password" name="password" asp-for="Password" placeholder="Enter your password" required>
        </div>

        <button type="submit" class="btn btn-primary w-100">Login</button>

        <div class="text-center mt-3">
            <small class="text-muted"> New User? <a asp-controller="Auth" asp-action="Register">Register here</a></small>
        </div>
    </div>    
</form>