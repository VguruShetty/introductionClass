<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - MVCApplication</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>

<!-- Lock viewport height to 100vh and prevent outer body scrolling -->
<body class="d-flex flex-column vh-100 overflow-hidden" style="background-color: #f1f5f9;">
    @if ((ViewData["HideNav"] == null || !(bool)ViewData["HideNav"]) && User.Identity != null && User.Identity.IsAuthenticated)
    {
        <header class="flex-shrink-0">
            <nav class="navbar navbar-expand-sm navbar-dark shadow-sm" style="background: linear-gradient(135deg, #1e3c72 0%, #2a5298 100%);">
                <div class="container">
                    <a class="navbar-brand fw-bold text-white d-flex align-items-center gap-2" asp-controller="Dashboard" asp-action="Index">
                        <i class="bi bi-box-seam-fill text-warning"></i> MVCApplication
                    </a>
                    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse">
                        <span class="navbar-toggler-icon"></span>
                    </button>
                    <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                        <ul class="navbar-nav flex-grow-1">
                            <li class="nav-item">
                                <a class="nav-link text-white fw-medium" asp-controller="Dashboard" asp-action="Index">Products</a>
                            </li>
                        </ul>
                        <ul class="navbar-nav ms-auto">
                            <li class="nav-item">
                                <span class="nav-link text-white">Hello, @User.Identity.Name</span>
                            </li>
                            <li class="nav-item">
                                <a class="btn btn-sm btn-outline-light ms-2 mt-1" asp-controller="Auth" asp-action="LogOutUser">Logout</a>
                            </li>
                        </ul>
                    </div>
                </div>
            </nav>
        </header>
    }
    <!-- 2. SCROLLABLE MIDDLE CONTENT (flex-grow-1 takes remaining space, overflow-y-auto enables scrolling) -->
    <main role="main" class="flex-grow-1 overflow-y-auto py-4">
        <div class="container">
            @RenderBody()
        </div>
    </main>

    <!-- 3. FIXED BOTTOM FOOTER (flex-shrink-0 keeps it permanently pinned) -->
    <footer class="flex-shrink-0 border-top bg-white text-muted py-3 shadow-sm">
        <div class="container text-center small">
            &copy; 2026 - MVCApplication - <a class="text-decoration-none" style="color: #1e3c72;" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>